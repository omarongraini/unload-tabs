{
  "manifest_version": 2,
  "name": "Tab Unloader",
  "version": "1.0",
  "description": "Unload tabs to free memory",
  "permissions": ["tabs", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Tab Unloader",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  }
}